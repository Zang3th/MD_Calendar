{
  "private": true,
  "scripts": {
    "check:types": "tsc -p jsconfig.json && tsc -p jsconfig.harness.json",
    "check:lint": "eslint . --max-warnings=0",
    "check:architecture": "node tools/check-architecture.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test --pass-with-no-tests",
    "verify": "npm run check:types && npm run check:lint && npm run check:architecture && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "5.9.3"
  }
}
